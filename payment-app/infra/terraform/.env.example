# ============================================================================
# TERRAFORM ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# Load with: export $(cat .env | xargs)
# Or use direnv: https://direnv.net/
# ============================================================================

# ----------------------------------------------------------------------------
# OpenShift Cluster Configuration
# ----------------------------------------------------------------------------

# OpenShift cluster API server URL
# Example: https://api.cluster-abc123.example.com:6443
TF_VAR_cluster_url=

# Service account token for OpenShift authentication
# Obtain with: oc serviceaccounts get-token <service-account-name> -n <namespace>
# Or create a long-lived token for automation
TF_VAR_cluster_token=

# ----------------------------------------------------------------------------
# GitHub Configuration
# ----------------------------------------------------------------------------

# GitHub Personal Access Token with 'repo' scope
# Create at: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
TF_VAR_github_token=

# GitHub organization or username
# Example: myorg or myusername
TF_VAR_github_owner=

# GitHub repository name (without owner prefix)
# Example: payment-application
TF_VAR_github_repository=

# ----------------------------------------------------------------------------
# GitHub Actions Secrets Configuration
# ----------------------------------------------------------------------------

# OpenShift cluster API URL for GitHub Actions
# Same as cluster_url above
TF_VAR_openshift_server=

# Service account token for GitHub Actions CI/CD
# Same as cluster_token above, or a dedicated service account token
TF_VAR_openshift_token=

# OpenShift internal image registry URL
# Obtain with: oc get route default-route -n openshift-image-registry --template='{{ .spec.host }}'
# Example: default-route-openshift-image-registry.apps.cluster-abc123.example.com
TF_VAR_openshift_registry=

# ----------------------------------------------------------------------------
# Namespace Configuration (Optional - defaults provided)
# ----------------------------------------------------------------------------

# Staging namespace name (default: bob-demo-staging)
# TF_VAR_namespace_staging=bob-demo-staging

# Production namespace name (default: bob-demo-prod)
# TF_VAR_namespace_prod=bob-demo-prod

# ----------------------------------------------------------------------------
# ResourceQuota Configuration (Optional - defaults provided)
# ----------------------------------------------------------------------------

# CPU requests limit (default: 4)
# TF_VAR_resource_quota_cpu_requests=4

# CPU limits (default: 8)
# TF_VAR_resource_quota_cpu_limits=8

# Memory requests limit (default: 8Gi)
# TF_VAR_resource_quota_memory_requests=8Gi

# Memory limits (default: 16Gi)
# TF_VAR_resource_quota_memory_limits=16Gi

# ----------------------------------------------------------------------------
# PostgreSQL Configuration (Optional - defaults provided)
# ----------------------------------------------------------------------------

# PostgreSQL container image (default: postgres:15)
# TF_VAR_postgres_image=postgres:15

# PostgreSQL storage size (default: 5Gi)
# TF_VAR_postgres_storage_size=5Gi

# PostgreSQL CPU limit (default: 1)
# TF_VAR_postgres_cpu_limit=1

# PostgreSQL memory limit (default: 2Gi)
# TF_VAR_postgres_memory_limit=2Gi

# PostgreSQL CPU request (default: 500m)
# TF_VAR_postgres_cpu_request=500m

# PostgreSQL memory request (default: 1Gi)
# TF_VAR_postgres_memory_request=1Gi

# ============================================================================
# USAGE INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Fill in all required values (those without defaults)
#
# 3. Load environment variables:
#    export $(cat .env | xargs)
#
# 4. Verify variables are set:
#    terraform plan
#
# 5. Apply configuration:
#    terraform apply
#
# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# - NEVER commit .env file to version control
# - Add .env to .gitignore
# - Use secure methods to store and transmit sensitive values
# - Rotate tokens and credentials regularly
# - Use least-privilege service accounts
# - Consider using a secrets manager (HashiCorp Vault, AWS Secrets Manager, etc.)
#
# ============================================================================